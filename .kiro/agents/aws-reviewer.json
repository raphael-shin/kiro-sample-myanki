{
  "name": "aws-reviewer",
  "description": "Read-only AWS Well-Architected reviewer used by the AI Review workflow. Uses the AWS Knowledge MCP server for official guidance and the AWS IaC MCP server to validate CloudFormation and look up CDK best practices.",
  "prompt": "You review pull requests against the AWS Well-Architected Framework. You only read files, query AWS documentation and run template validation; you never modify anything, run shell commands or call AWS APIs.",
  "tools": [
    "read",
    "grep",
    "glob",
    "code",
    "@aws-knowledge-mcp-server",
    "@aws-iac-mcp-server/validate_cloudformation_template",
    "@aws-iac-mcp-server/check_cloudformation_template_compliance",
    "@aws-iac-mcp-server/get_cloudformation_pre_deploy_validation_instructions",
    "@aws-iac-mcp-server/search_cloudformation_documentation",
    "@aws-iac-mcp-server/search_cdk_documentation",
    "@aws-iac-mcp-server/search_cdk_samples_and_constructs",
    "@aws-iac-mcp-server/cdk_best_practices",
    "@aws-iac-mcp-server/read_iac_documentation_page"
  ],
  "allowedTools": [
    "read",
    "grep",
    "glob",
    "code",
    "@aws-knowledge-mcp-server",
    "@aws-iac-mcp-server/validate_cloudformation_template",
    "@aws-iac-mcp-server/check_cloudformation_template_compliance",
    "@aws-iac-mcp-server/get_cloudformation_pre_deploy_validation_instructions",
    "@aws-iac-mcp-server/search_cloudformation_documentation",
    "@aws-iac-mcp-server/search_cdk_documentation",
    "@aws-iac-mcp-server/search_cdk_samples_and_constructs",
    "@aws-iac-mcp-server/cdk_best_practices",
    "@aws-iac-mcp-server/read_iac_documentation_page"
  ],
  "mcpServers": {
    "aws-knowledge-mcp-server": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "aws-iac-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.aws-iac-mcp-server@latest"],
      "env": {
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "timeout": 120000
    }
  },
  "includeMcpJson": false,
  "resources": [],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "aws-knowledge-mcp-server/*",
          "aws-iac-mcp-server/validate_cloudformation_template",
          "aws-iac-mcp-server/check_cloudformation_template_compliance",
          "aws-iac-mcp-server/get_cloudformation_pre_deploy_validation_instructions",
          "aws-iac-mcp-server/search_cloudformation_documentation",
          "aws-iac-mcp-server/search_cdk_documentation",
          "aws-iac-mcp-server/search_cdk_samples_and_constructs",
          "aws-iac-mcp-server/cdk_best_practices",
          "aws-iac-mcp-server/read_iac_documentation_page"
        ],
        "effect": "allow"
      }
    ]
  }
}
